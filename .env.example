# yazhi-api chat backend — the /chat UI streams through this service.
# Contract: OpenAI-compatible Chat Completions (SSE). See
# src/lib/chat/backend.ts — the single integration point for yazhi-api.
YAZHI_API_URL=
YAZHI_API_KEY=
YAZHI_CHAT_PATH=/v1/chat/completions

# Circle sign-in for builders (/bubble) — yazhi-api gRPC.
# See src/lib/circle/client.ts (single integration point) and /bubble#circle.
YAZHI_GRPC_TARGET=
# "1" to use TLS; required whenever yazhi-api is not on loopback.
YAZHI_GRPC_TLS=
# Builder sign-up: the Circle key of a yazhi.dev app account, scoped to the
# company new builders are created in. Leave empty to keep sign-up closed.
YAZHI_CIRCLE_APP_KEY=
YAZHI_CIRCLE_COMPANY_ID=
# Models a bubble may run on through yazhi-api (comma-separated allow-list).
# Also what GET /api/health reports as `models`.
YAZHI_BUBBLE_MODELS=adhan

# ── Yazhi API kernel (src/lib/api/**) — see docs/API.md ─────────────────────

# The bubble registry's signing secret (HMAC-SHA256 over canonical manifest
# JSON). Set it in production. Leave empty and the registry still works, but
# every version is stored unsigned and publish answers warnings: ["unsigned"].
#   openssl rand -base64 32
YAZHI_REGISTRY_SECRET=

# Who may review bubbles: comma-separated Circle account ids and/or emails
# (emails matched case-insensitively). This stands in for the
# community.maintainer IAM role, which yazhi-api will expose later; until
# then it is the only source. EMPTY = NOBODY is a maintainer and every review
# answers 403 not_maintainer (fail-closed).
YAZHI_MAINTAINERS=

# Use the yazhi-api YazhiBubbles gRPC registry instead of the in-memory one.
# BOTH must be set: YAZHI_GRPC_TARGET (above) and YAZHI_REGISTRY_GRPC=1.
# The gRPC path is NOT WIRED YET — with it on, registry calls answer 503
# not_configured rather than silently falling back. See
# src/lib/api/registry-grpc.ts for what wiring it takes.
YAZHI_REGISTRY_GRPC=

# Translation provider (ROUTE-CONTRACTS §A). First present pair wins; else
# YAZHI_API_URL is used; with none, POST /api/translate answers 503
# not_configured instead of crashing.
YAZHI_TRANSLATE_URL=
YAZHI_TRANSLATE_KEY=
