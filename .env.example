# yazhi-api chat backend — the /chat UI streams through this service.
# Contract: OpenAI-compatible Chat Completions (SSE). See
# src/lib/chat/backend.ts — the single integration point for yazhi-api.
YAZHI_API_URL=
YAZHI_API_KEY=
YAZHI_CHAT_PATH=/v1/chat/completions

# yazhi-api gRPC services (Bubble Interface pages: /foundry, …), called via
# the Connect protocol's JSON mapping through a gRPC-JSON gateway:
#   POST {YAZHI_RPC_URL}/{package.Service}/{Method}   (Bearer YAZHI_API_KEY)
# Unset → pages render the audited sample data, labelled "Sample".
# See docs/BUBBLE-INTERFACE.md and src/lib/yazhi-api/rpc.ts.
YAZHI_RPC_URL=
