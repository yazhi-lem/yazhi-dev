# yazhi-api chat backend — the /chat UI streams through this service.
# Contract: OpenAI-compatible Chat Completions (SSE). See
# src/lib/chat/backend.ts — the single integration point for yazhi-api.
YAZHI_API_URL=
YAZHI_API_KEY=
YAZHI_CHAT_PATH=/v1/chat/completions

# Bubble UI pages read yazhi-api's gRPC services through a Connect /
# gRPC-JSON gateway: POST {YAZHI_RPC_URL}/{package.Service}/{Method},
# with YAZHI_API_KEY as a bearer, server-side only.
# See docs/BUBBLE-INTERFACE.md and src/lib/yazhi-api/rpc.ts.
YAZHI_RPC_URL=

# Enquiries from /projects/[slug] — an inbox endpoint on Yazhi's own
# servers (never a third-party form service; Aram 2). /api/enquiry
# validates each enquiry and POSTs it here as JSON, with the token as a
# bearer when set. Unset → the form says the inbox isn't connected yet
# and that nothing was sent; nothing is stored anywhere.
YAZHI_ENQUIRY_URL=
YAZHI_ENQUIRY_TOKEN=
