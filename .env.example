# yazhi-api chat backend — the /chat UI streams through this service.
# Contract: OpenAI-compatible Chat Completions (SSE). See
# src/lib/chat/backend.ts — the single integration point for yazhi-api.
YAZHI_API_URL=
YAZHI_API_KEY=
YAZHI_CHAT_PATH=/v1/chat/completions

# yazhi-api HTTP shim for the Telugu Legal / Healthcare workspaces
# (/workspaces/legal, /workspaces/health → src/lib/workspace/backend.ts).
# Local dev: ./run.sh in yazhi-api serves it on :8080. Falls back to YAZHI_API_URL.
YAZHI_WORKSPACE_API_URL=http://localhost:8080

# Workspace auth (src/lib/workspace/session.ts). /api/workspace refuses to
# forward without a signed session cookie scoped to a tenant.
#   WORKSPACE_SESSION_SECRET  — >= 32 random chars (openssl rand -base64 48). Required.
#   WORKSPACE_DEMO_LOGIN      — "true" only on previews: offers fictional demo tenants.
#   YAZHI_WORKSPACE_GATEWAY_TOKEN — must equal yazhi-api TELUGU_GATEWAY_TOKEN.
#   WORKSPACE_RATE_LIMIT_PER_MIN  — per session, default 30.
WORKSPACE_SESSION_SECRET=
WORKSPACE_DEMO_LOGIN=false
YAZHI_WORKSPACE_GATEWAY_TOKEN=
WORKSPACE_RATE_LIMIT_PER_MIN=30
