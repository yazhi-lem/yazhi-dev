# yazhi-api chat backend — the /chat UI streams through this service.
# Contract: OpenAI-compatible Chat Completions (SSE). See
# src/lib/chat/backend.ts — the single integration point for yazhi-api.
YAZHI_API_URL=
YAZHI_API_KEY=
YAZHI_CHAT_PATH=/v1/chat/completions

# Circle sign-in for builders (/bubble, /foundry) — yazhi-api gRPC.
# See src/lib/circle/client.ts (single integration point) and /bubble#circle.
YAZHI_GRPC_TARGET=
# "1" to use TLS; required whenever yazhi-api is not on loopback.
YAZHI_GRPC_TLS=
# Builder sign-up: the Circle key of a yazhi.dev app account, scoped to the
# company new builders are created in. Leave empty to keep sign-up closed.
YAZHI_CIRCLE_APP_KEY=
YAZHI_CIRCLE_COMPANY_ID=
# Models a bubble may run on through yazhi-api (comma-separated allow-list).
YAZHI_BUBBLE_MODELS=adhan
