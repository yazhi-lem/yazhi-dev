# yazhi-api chat backend — the /chat UI streams through this service.
# Contract: OpenAI-compatible Chat Completions (SSE). See
# src/lib/chat/backend.ts — the single integration point for yazhi-api.
YAZHI_API_URL=
YAZHI_API_KEY=
YAZHI_CHAT_PATH=/v1/chat/completions

# yazhi-api HTTP shim for the Telugu Legal / Healthcare workspaces
# (/workspaces/legal, /workspaces/health → src/lib/workspace/backend.ts).
# Local dev: ./run.sh in yazhi-api serves it on :8080. Falls back to YAZHI_API_URL.
YAZHI_WORKSPACE_API_URL=http://localhost:8080
