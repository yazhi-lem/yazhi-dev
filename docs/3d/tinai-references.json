  "scenes": [
    {
      "tinai": "kurinji",
      "id": "K1",
      "title": "யாமம், அருவியருகே · Midnight by the waterfall",
      "brief": "Moonlight and mist layers on the ridge. Venkai in bloom, kantal on the slope, an elephant passing below, the waterfall as the one bright stroke. Camera: a slow climb up the ridge. Verse: Kuruntokai 40 (rain on red earth)."
    },
    {
      "tinai": "kurinji",
      "id": "K2",
      "title": "தினை காத்தல் · Guarding the millet",
      "brief": "Late-morning sun. A millet clearing, the watch platform, parrot flocks swooping in and scattering, a rock-bee comb on the cliff, a monkey watching from the venkai."
    },
    {
      "tinai": "kurinji",
      "id": "K3",
      "title": "கூதிர் மழை · Rain on the ridge",
      "brief": "Rain bands sweep through, the waterfall swells, the spring fills, and the slope turns kurinji-blue."
    },
    {
      "tinai": "mullai",
      "id": "M1",
      "title": "கார்ப் பருவம் · Evening, first rains",
      "brief": "Konrai racemes swinging, jasmine opening at dusk, Kangayam cattle walking home, the sound of a flute, a pair of deer at the forest edge. Verse: Ainkurunuru 437."
    },
    {
      "tinai": "mullai",
      "id": "M2",
      "title": "தேர் வரவு · The chariot returns",
      "brief": "A chariot on the forest road at dusk, bees over the jasmine, fireflies rising. This is the payoff of waiting."
    },
    {
      "tinai": "mullai",
      "id": "M3",
      "title": "காத்திருப்பு · Waiting, as a timeline",
      "brief": "Scroll scrubs the season from dry to rain: bare konrai turns golden, the jasmine buds open, the stream fills."
    },
    {
      "tinai": "marutham",
      "id": "R1",
      "title": "வைகறை · Before dawn",
      "brief": "Mist on the ponds, white water lilies opening as the light comes (Ainkurunuru 68), a painted stork stepping through the shallows, buffalo wallowing, valai fish leaping."
    },
    {
      "tinai": "marutham",
      "id": "R2",
      "title": "நெல்லரிதல் · The paddy harvest",
      "brief": "Golden paddy, reapers as roles, sheaves on the bunds, the harvest drum, clay granaries, sugarcane at the edge."
    },
    {
      "tinai": "marutham",
      "id": "R3",
      "title": "ஊர்த் துறை · The village landing",
      "brief": "Arjuna trees along the river, a lotus pond, the bard on his way to the house."
    },
    {
      "tinai": "neytal",
      "id": "N1",
      "title": "எற்பாடு · Boats coming home",
      "brief": "Late-afternoon light, catamarans coming in through the surf, nets drying, a punnai grove, little egrets on the creek."
    },
    {
      "tinai": "neytal",
      "id": "N2",
      "title": "உப்பளம் · The salt pans",
      "brief": "White pans, a caravan of salt carts on the dyke, screwpine hedges, a heron in the shallows."
    },
    {
      "tinai": "neytal",
      "id": "N3",
      "title": "ஏக்கம் · Tide and longing",
      "brief": "The tide rising into the creek, beach morning glory on the dunes, a fin offshore, the moon coming up. Verse: Ainkurunuru 101 (his chariot crushing the adumbu vines)."
    },
    {
      "tinai": "palai",
      "id": "P1",
      "title": "நண்பகல் கடத்தல் · The midday crossing",
      "brief": "Heat haze, short shadows, travellers as roles at the forked paths, kalli and thorn scrub, a hero stone at the fork, a tiger on the ridge."
    },
    {
      "tinai": "palai",
      "id": "P2",
      "title": "வற்றிய சுனை · The dried spring",
      "brief": "A worn-out elephant at a dried spring and a dug pit, vultures and kites circling, a pack of wild dogs at the edge."
    },
    {
      "tinai": "palai",
      "id": "P3",
      "title": "இளவேனில் · The season turns",
      "brief": "Mahua flowers drop, the scorched mango bough sprouts red leaves (Ainkurunuru 349), a house crow on the branch. He has not come, but the season has."
    }
  ]
}