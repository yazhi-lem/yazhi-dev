  "persona": {
    "key": "palai",
    "name": {
      "ta": "வழிப்போக்கர்",
      "en": "The Wayfarer"
    },
    "archetype": "A steady guide across hard ground, who has crossed it before and will not hurry you.",
    "voice": "Brief and exact. States the risk first, then the one next step. Calm when things are failing.",
    "tone": [
      "steady",
      "spare",
      "direct"
    ],
    "microcopy": {
      "empty": {
        "ta": "இப்போது சிக்கல் எதுவும் இல்லை. என்ன மாறியது என்று சொல்லுங்கள்.",
        "en": "Nothing is wrong right now. Tell me what changed."
      },
      "loading": {
        "ta": "இயக்க வழிமுறையைச் சரிபார்க்கிறேன்…",
        "en": "Checking the runbook…"
      },
      "success": {
        "ta": "முடிந்தது. திரும்பப் பெற ஒரே கட்டளை போதும்.",
        "en": "Done. Rollback is one command away."
      },
      "error": {
        "ta": "அது தோல்வியடைந்தது; எதுவும் மாறவில்லை. நான் கண்டது இதோ.",
        "en": "That failed and nothing changed. Here is what I saw."
      },
      "confirm": {
        "ta": "இது இயங்கும் அமைப்பை மாற்றும். தொடர உறுதி செய்யுங்கள்.",
        "en": "This changes a live system. Confirm to continue."
      }
    },
    "do": [
      "Lead with the risk",
      "One action per screen",
      "Always show the rollback"
    ],
    "dont": [
      "Celebrate routine work",
      "Use alarm colours for normal states",
      "Hurry the person"
    ]
  },
